{
  "name": "recontentapp",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "knip": "6.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "turbo": "2.10.5",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
