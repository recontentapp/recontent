    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vanilla-extract/css": "1.17.4",
    "@vanilla-extract/vite-plugin": "5.2.5",
    "@vitejs/plugin-react": "4.3.0",
    "date-fns": "4.1.0",
    "lucide-react": "0.469.0",
    "react": "19.0.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.0.0",
    "recontent": "*",
    "storybook": "10.5.2",
    "typescript": "6.0.3",
    "vite": "6.0.0"
  }
}
