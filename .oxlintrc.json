{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.vocs/**",
    "**/storybook-static/**",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/*.gen.css.ts"
  ]
}
