    "transitionScale": {
      "fast": {
        "$value": {
          "duration": {
            "value": 100,
            "unit": "ms"
          },
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": [
            0.24,
            1,
            0.4,
            1
          ]
        }
      },
      "slow": {
        "$value": {
          "duration": {
            "value": 400,
            "unit": "ms"
          },
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": [
            0.24,
            1,
            0.4,
            1
          ]
        }
      },
      "$type": "transition"
    },
    "gradients": {
      "accent": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{ref.color.primary.700}",
            "position": 0
          },
          {
            "color": "{ref.color.primary.500}",
            "position": 1
          }
        ],
        "$extensions": {
          "com.recontent": {
            "kind": "linear",
            "angle": "135deg"
          }
        }
      }
    }
  }
}