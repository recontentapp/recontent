exports[`golden snapshots css 1`] = `
":root {
  --ref-color-black: #000000;
  --ref-color-white: #ffffff;
  --ref-fontFamily-body: Arial;
  --ref-weight-brand: 500;
  --ref-motion-duration: 200ms;
  --ref-motion-easing: cubic-bezier(0.4, 0, 0.2, 1);
  --ref-spacing-0: 0px;
  --ref-spacing-1: 4px;
  --ref-spacing-2: 8px;
  --ref-palette-100: #111111;
  --ref-palette-200: #222222;
}

:root {
  /* Primary accent color. */
  --system-colors-accent: var(--ref-color-black);
  --system-colors-surface: var(--ref-color-white);
  --system-shadow-elevated: inset 0px 2px 4px 0px var(--ref-color-black), 0px 1px 2px 0px #111111;
  --system-border-default: 1px solid var(--ref-color-black);
  --system-transition-standard-transition-duration: var(--ref-motion-duration);
  --system-transition-standard-transition-delay: 0ms;
  --system-transition-standard-transition-timing-function: var(--ref-motion-easing);
  --system-gradient-accent: linear-gradient(90deg, var(--ref-color-black) 0%, var(--ref-color-white) 100%);
  --system-typography-body-font-family: var(--ref-fontFamily-body);
  --system-typography-body-font-size: 16px;
  --system-typography-body-font-weight: 400;
  --system-typography-body-letter-spacing: 0px;
  --system-typography-body-line-height: 1.4;
}

:root {
  /* Primary accent color. */
  --button-background: var(--system-colors-accent);
  --button-border: var(--system-border-default);
}

[data-theme="dark"] {
  --ref-color-black: #eeeeee;
}

[data-theme="highContrast"] {
  --system-colors-accent: #ff0000;
}"
`;

