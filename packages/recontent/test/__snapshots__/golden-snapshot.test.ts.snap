exports[`golden snapshots stylex 1`] = `
"// ---- tokens.stylex.ts ----
// @ts-nocheck
import * as stylex from "@stylexjs/stylex";

export const vars = stylex.defineVars({
  refColorBlack: '#000000',
  refColorWhite: '#ffffff',
  refFontFamilyBody: 'Arial',
  refWeightBrand: '500',
  refMotionDuration: '200ms',
  refMotionEasing: 'cubic-bezier(0.4, 0, 0.2, 1)',
  refSpacing0: '0px',
  refSpacing1: '4px',
  refSpacing2: '8px',
  refPalette100: '#111111',
  refPalette200: '#222222',
  systemColorsAccent: () => \`\${vars.refColorBlack}\`,
  systemColorsSurface: () => \`\${vars.refColorWhite}\`,
  systemShadowElevated: () => \`inset 0px 2px 4px 0px \${vars.refColorBlack}, 0px 1px 2px 0px #111111\`,
  systemBorderDefault: () => \`1px solid \${vars.refColorBlack}\`,
  systemTransitionStandardTransitionDuration: () => \`\${vars.refMotionDuration}\`,
  systemTransitionStandardTransitionDelay: '0ms',
  systemTransitionStandardTransitionTimingFunction: () => \`\${vars.refMotionEasing}\`,
  systemGradientAccent: () => \`linear-gradient(90deg, \${vars.refColorBlack} 0%, \${vars.refColorWhite} 100%)\`,
  systemTypographyBodyFontFamily: () => \`\${vars.refFontFamilyBody}\`,
  systemTypographyBodyFontSize: '16px',
  systemTypographyBodyFontWeight: '400',
  systemTypographyBodyLetterSpacing: '0px',
  systemTypographyBodyLineHeight: '1.4',
  componentsButtonBackground: () => \`\${vars.refColorBlack}\`,
  componentsButtonBorder: () => \`\${vars.systemBorderDefault}\`,
});


// ---- reset.gen.css ----
*, *::before, *::after {
  box-sizing: border-box;
}

*:not(dialog) {
  margin: 0;
}

@media (prefers-reduced-motion: no-preference) {
html {
  interpolate-size: allow-keywords;
}
}

body {
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  font-family: Arial;
}

img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
}

input, button, textarea, select {
  font: inherit;
}

p, h1, h2, h3, h4, h5, h6 {
  overflow-wrap: break-word;
}

p {
  text-wrap: pretty;
}

h1, h2, h3, h4, h5, h6 {
  text-wrap: balance;
}

::placeholder {
  color: #000000;
}


// ---- themes.ts ----
import * as stylex from "@stylexjs/stylex";
import { vars } from "./tokens.stylex.js";

export const darkTheme = stylex.createTheme(vars, {
  refColorBlack: '#eeeeee',
});

export const highContrastTheme = stylex.createTheme(vars, {
  systemColorsAccent: '#ff0000',
});


// ---- scales.ts ----
import { vars } from "./tokens.stylex.js";

export type RefSpacing = 0 | 1 | 2;

export const refSpacing = {
  0: vars.refSpacing0,
  1: vars.refSpacing1,
  2: vars.refSpacing2,
} as const;

export type RefPalette = 100 | 200;

export const refPalette = {
  100: vars.refPalette100,
  200: vars.refPalette200,
} as const;
"
`;

