{
  "name": "recontent",
  "version": "0.1.0",
  "bin": "./dist/cli/bin.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./generators/dtcg": "./dist/core/generators/dtcg.mjs",
    "./generators/html": "./dist/core/generators/html.mjs",
    "./outputs/css": "./dist/outputs/css.mjs",
    "./outputs/vanilla-extract": "./dist/outputs/vanilla-extract.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/core/generators/dtcg.ts src/core/generators/html.ts src/outputs/css.ts src/outputs/vanilla-extract.ts src/cli/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.mjs",
    "dev:tokens": "node dist/cli/bin.mjs build -c dev/recontent.config.ts",
    "dev": "yarn dev:tokens && storybook dev -c dev/.storybook -p 6006",
    "storybook": "storybook dev -c dev/.storybook -p 6006",
    "build-storybook": "storybook build -c dev/.storybook -o dev/storybook-static"
  },
  "dependencies": {
    "@recontentapp/core": "0.1.1",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@base-ui/react": "1.0.0",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@types/node": "22.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vanilla-extract/css": "1.17.4",
    "@vanilla-extract/vite-plugin": "5.2.5",
    "@vitejs/plugin-react": "4.3.0",
    "lucide-react": "0.511.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "10.5.2",
    "tsdown": "0.22.9",
    "typescript": "6.0.3"
  }
}
