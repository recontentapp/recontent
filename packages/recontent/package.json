{
  "name": "recontent",
  "version": "0.3.0",
  "keywords": [
    "design tokens",
    "dtcg"
  ],
  "homepage": "https://recontent.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/recontentapp/recontent"
  },
  "bin": "./dist/cli/bin.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.mts",
      "default": "./dist/plugins/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/plugins/index.ts src/cli/bin.ts src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^15.1.0",
    "jiti": "^2.7.0",
    "marked": "^18.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@base-ui/react": "1.9.0",
    "@jest/globals": "30.5.2",
    "@stylexjs/babel-plugin": "0.19.2",
    "@stylexjs/stylex": "0.19.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/node": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "class-variance-authority": "0.7.1",
    "jest": "30.5.2",
    "react": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7"
  }
}
