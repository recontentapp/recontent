{
  "name": "recontent",
  "version": "0.1.0",
  "bin": "./dist/cli/bin.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./generators/dtcg": "./dist/core/generators/dtcg.mjs",
    "./generators/html": "./dist/core/generators/html.mjs",
    "./outputs/css": "./dist/outputs/css.mjs",
    "./outputs/vanilla-extract": "./dist/outputs/vanilla-extract.mjs",
    "./outputs/typescript": "./dist/outputs/typescript.mjs",
    "./outputs/typescript-native": "./dist/outputs/typescript-native.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/core/generators/dtcg.ts src/core/generators/html.ts src/outputs/css.ts src/outputs/vanilla-extract.ts src/outputs/typescript.ts src/outputs/typescript-native.ts src/cli/bin.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.dev.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest && yarn test:dtcg",
    "test:dtcg": "yarn dev:build && yarn dev:dtcg && yarn dev:dtcg:lint",
    "dev": "yarn dev:build && storybook dev -c dev/.storybook -p 6006",
    "dev:build": "node dist/cli/bin.mjs build -c dev/recontent.config.ts",
    "dev:html": "node dist/cli/bin.mjs html-export -c dev/recontent.config.ts -o dev/generated/tokens.html",
    "dev:dtcg": "node dist/cli/bin.mjs dtcg-export -c dev/recontent.config.ts -o dev/generated/",
    "dev:doctor": "node dist/cli/bin.mjs doctor -c dev/recontent.config.ts",
    "dev:diff": "node dist/cli/bin.mjs diff -c dev/recontent.config.ts",
    "dev:dtcg:lint": "npx tz check dev/generated/tokens.tokens.json && npx tz check dev/generated/blackTheme.tokens.json"
  },
  "dependencies": {
    "@recontentapp/core": "0.1.1",
    "commander": "^15.0.0",
    "semver": "^7.7.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@base-ui/react": "1.0.0",
    "@jest/globals": "30.2.0",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@terrazzo/cli": "2.5.0",
    "@types/node": "22.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/semver": "7.7.1",
    "@vanilla-extract/css": "1.17.4",
    "@vanilla-extract/vite-plugin": "5.2.5",
    "jest": "30.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "10.5.2",
    "tsdown": "0.22.9"
  }
}
