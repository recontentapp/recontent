{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/recontent": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@base-ui/react", "@stylexjs/stylex"]
    },
    "apps/vanilla-extract-playground": {
      "entry": ["recontent.config.ts", ".storybook/preview.tsx"],
      "project": ["src/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/generated/**"],
      "storybook": {
        "config": [".storybook/main.ts"]
      }
    },
    "apps/stylex-playground": {
      "entry": ["recontent.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/generated/**"]
    }
  }
}
