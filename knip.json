{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/recontent": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@base-ui/react",
        "@stylexjs/stylex",
        "@types/react",
        "class-variance-authority",
        "react",
        "tailwindcss"
      ]
    },
    "apps/vanilla-extract-playground": {
      "entry": ["recontent.config.ts", "src/components.ts"],
      "project": ["src/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/generated/**"],
      "storybook": {
        "config": [".storybook/main.ts"]
      }
    },
    "apps/stylex-playground": {
      "entry": ["recontent.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/generated/**"]
    },
    "apps/tailwind-playground": {
      "entry": ["recontent.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/docs": {
      "entry": [
        "vocs.config.ts",
        "recontent.config.ts",
        "src/pages/**/*.{md,mdx,tsx}",
        "src/snippets/*.config.ts",
        "test/*.test.mjs"
      ],
      "project": ["src/**/*.ts", "test/*.mjs", "*.ts"],
      "ignore": ["src/pages.gen.ts"]
    }
  }
}
